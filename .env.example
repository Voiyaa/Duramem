# ===== 服务 =====
BACKEND_PORT=8001
FRONTEND_PORT=5174
DATA_DIR=./data
DEFAULT_DB=duramem

# ===== Embedding（OpenAI 兼容，可换硅基流动 / 百炼 / Ollama）=====
#
# 这一组现在可以在前端「模型」页改，改完立即生效、不用重启，也不用动这个文件。
# 界面写入的值存在 data/provider_config.json，优先于这里的环境变量。
# 这里的值仍然有意义：它是"第一次启动时的默认"，以及没装前端时的配置入口。
#
# 界面与 CLI（duramem providers）都能配置，密钥保存后只回显掩码。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# 离线模式：无 API Key 时服务会自动打开它，用确定性哈希伪向量，
# 仅供开发与测试——它没有语义泛化能力。在界面填上 Key 会自动关掉。
EMBEDDING_FAKE=false
# 请求里是否带 dimensions 参数：百炼 text-embedding-v3/v4、OpenAI text-embedding-3-* 需要
EMBEDDING_SEND_DIMENSIONS=false

# ===== 重排（可选，默认关闭）=====
# 同 Embedding：可在前端「模型」页或 duramem providers 里改
RERANK_ENABLED=false
RERANK_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 摘要模型（OpenAI 兼容）=====
# 同 Embedding：可在前端「模型」页里改。两项都空时用离线抽取式摘要
SUMMARY_API_KEY=
SUMMARY_BASE_URL=
SUMMARY_MODEL=deepseek-chat

# ===== 主模型（会话级总结用）=====
MAIN_MODEL_API_KEY=
MAIN_MODEL_BASE_URL=
MAIN_MODEL=

# ===== 检索 =====
VECTOR_TOP_K=20
LEXICAL_TOP_K=20
FUSION_POOL=30
RRF_K=60
RERANK_TOP_K=5
# 每批发给嵌入接口的条数。百炼 text-embedding-v3/v4 上限是 10，超了返回 400
EMBED_BATCH_SIZE=32

# 向量相关性下限（余弦距离：0=同向，1=正交，2=反向）
# 刻意宽松，只剔除近似正交的结果。收紧它与嵌入模型强绑定，风险大。
VECTOR_MAX_DISTANCE=0.9
# 超过此值只告警不剔除，让模型知道「本次结果相关性偏低」
VECTOR_WEAK_DISTANCE=0.75

# sqlite-vec 的向量分配块大小。默认 1024 会让每个库带上约 4 MB 的固定开销
# （1024 条 × 1024 维 × 4 字节），与库里实际有几条向量无关。
# 实测 16~1024 对 KNN 延迟没有可测差异，所以取小值：64 时固定开销约 288 KB。
# 注意：这是建表选项，改它需要执行 duramem rebuild-vectors --db <库名>
VECTOR_CHUNK_SIZE=64

# ===== 总结触发 =====
AUTO_SUMMARY_ENABLED=false
SUMMARY_INTERVAL=30
SUMMARY_MIN_MESSAGES=4
SUMMARY_MAX_CHUNKS=8

# ===== 记忆深度（三层：L0 摘要 / L1 会话概览 / L2 原文）=====
# 两个独立开关，对应两种日常模式：
#   都关 = 日常模式（模型只看得到摘要与简介）
#   都开 = 工作模式（摘要/简介 → 会话概览 → 切片原文，由模型逐层自己决定）
#
# v3 起改用语义化命名（历史键名 L1_ACCESS_ENABLED / L2_ACCESS_ENABLED 已废弃，
# 命名对照见设计文档 0.1 节 U 决策）。代码保留了"未设新键时回退读旧键"的兼容，
# 但旧键语义映射的是原文开关，不映射概览开关。
OVERVIEW_ACCESS_ENABLED=true
ORIGINAL_ACCESS_ENABLED=true

# 每轮取回量的**软**阈值（token）。0 = 不设限，读多少给多少——照 OpenViking,
# 它对原文读取不设上限，体量靠"定位精度"控制而不是限额。设成正数也只是在返回里
# 加一句提示，不会拒绝任何回查。
#
# 历史：这个键原先叫 READ_BUDGET_TOKENS 且是硬限额（默认 4000），会拒绝超额的
# 读取并退化成摘要。那条设计已撤销——实测它把一条 7956 token 的区间拒掉、
# 只给 500 token，丢 94%，而现代上下文完全装得下。
READ_SOFT_LIMIT_TOKENS=0
READ_BUDGET_IDLE_RESET=120
DEFAULT_WINDOW_EXPAND=1

# ===== 摘要限制（按 token，非字符）=====
SUMMARY_TARGET_TOKENS=180
SUMMARY_SOFT_LIMIT_TOKENS=256

# ===== 会话层（容器层）=====
# L1 概览由模型生成，L0 摘要从 L1 首段机械抽取（零额外生成成本）。
# L1 是地图不是缩印本：标题/简述/覆盖度/导航四节，1600 是宽裕上限。
OVERVIEW_TARGET_TOKENS=1600
ABSTRACT_TOKENS=256
# 一份概览最多用多少条切片作输入，超限按区间均匀抽样（首尾都保留）
SESSION_OVERVIEW_SAMPLE_LIMIT=32
# 宽会话的刷新阈值：待跟上的变化占比达到它就重生成概览，否则只累计计数。
# 不做时间兜底（与 OpenViking 一致）——想立刻更新就显式重生成。
SESSION_OVERVIEW_REFRESH_RATIO=0.10
# 每次检索最多返回几条会话命中
SESSION_TOP_K=3
# 会话重排的打分体预算（L1 上限 4000，但判别力最强的简述/覆盖度/导航都在前 1200）
SESSION_RERANK_MAX_TOKENS=1200

# ===== 跨库检索（默认关闭）=====

# ===== OpenAI 兼容记忆网关（采集原文，接入成本最低的路线）=====
# 开启后，把聊天客户端的 base_url 指向本服务的 /v1 即可
GATEWAY_ENABLED=false
GATEWAY_UPSTREAM_BASE_URL=
GATEWAY_UPSTREAM_API_KEY=
# 每轮自动检索记忆并注入 system prompt（"被动模式"）
# 注意：注入是摘要，模型的主动回查能力仍要靠 MCP 工具
GATEWAY_INJECT_MEMORY=true

# 说明：MCP 冷启动注入（每个库自己的"库主留言"）配置存在各库文件内部
# （db_meta），在库管理页按库编辑，不在这里。

# ===== 并发 =====
SQLITE_WAL=true
WRITE_QUEUE_SIZE=100

# ===== 分词 =====
# 额外受保护词（逗号分隔）：项目代号、错误码、人名等，保证不被切碎
TOKENIZER_EXTRA_WORDS=
TOKENIZER_USER_DICT=
TOKENIZER_STOPWORDS_ENABLED=true